# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase
# (botón Connect o Project Settings → API Keys). Sin estas variables la app arranca en modo demo.
# Sirve la Publishable key (sb_publishable_...) o la legacy anon key (eyJ...).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
